{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Safari NIKKE Guard",
  "version": "1.0.0",
  "identifier": "io.github.ppin-gu.safari-nikke-guard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Safari NIKKE Guard",
        "width": 1040,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
